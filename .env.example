# Public URL of the deployed frontend, used to turn /demo assets into URLs
# that the backend and Fal.ai can fetch.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL of the Express avatar pipeline.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Demo/dev mode toggle. Keep true while the app is still using mock data sources.
# Set to false only when production APIs are ready.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Browser-visible app version for quick verification in deployed environments.
NEXT_PUBLIC_APP_VERSION=v0.1.0-alpha.1